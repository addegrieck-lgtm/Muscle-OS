# Secrets de production — copier en deploy/.env sur le serveur, ne JAMAIS commiter.
POSTGRES_PASSWORD=
# openssl rand -hex 32 — identique à api.secret du plugin
BRIDGE_KEYS=factions-1:
# openssl rand -hex 32
ADMIN_API_TOKEN=
# openssl rand -hex 32 — jeton partagé site ↔ API (connexion, inscription)
WEB_INTERNAL_TOKEN=
# openssl rand -hex 16 — code pour devenir propriétaire (Mon compte → Accès équipe), à vider après usage
ADMIN_SETUP_CODE=
# Connexion Discord (facultative)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Secours Basic Auth du back-office (facultatif, laisser vide sinon)
ADMIN_USER=
ADMIN_PASSWORD=
MC_PING_HOST=play.vaeloria.fr
DISCORD_WEBHOOK_URL=
