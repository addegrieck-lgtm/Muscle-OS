# HTTPS automatique (Let's Encrypt). DOMAIN vient de deploy/.env (ex. vaeloria.fr). Mettre Cloudflare (gratuit) devant pour le CDN.
{$DOMAIN}, www.{$DOMAIN} {
	encode zstd gzip
	@admin path /admin /admin/*
	handle @admin {
		reverse_proxy admin:3001
	}
	handle {
		reverse_proxy web:3000
	}
}

api.{$DOMAIN} {
	encode zstd gzip
	reverse_proxy api:4000
}
