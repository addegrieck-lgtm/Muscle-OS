# Copier en .env.local (jamais commité). Seules des valeurs PUBLIQUES vont dans l'application :
# les variables EXPO_PUBLIC_* sont incluses dans le bundle mobile.

# Supabase — URL du projet et clé « anon » publique (les données sont protégées par RLS).
# Laisser vide : l'application fonctionne en mode 100 % local, comptes/défis/coach affichés « non configurés ».
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# RevenueCat — clés SDK publiques par plateforme (appl_… / goog_…) et identifiant du droit.
# Laisser vide : l'écran Premium indique que les achats ne sont pas encore disponibles.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=premium

# ── Secrets SERVEUR : à définir dans Supabase (supabase secrets set …), JAMAIS ici ni dans l'app ──
# ANTHROPIC_API_KEY            clé du fournisseur IA utilisée par l'Edge Function « coach »
# COACH_MODEL                  modèle (défaut : claude-opus-5-5)
# COACH_DAILY_LIMIT            questions par jour et par abonné (défaut : 20)
# REVENUECAT_WEBHOOK_SECRET    secret partagé avec le webhook RevenueCat
# REVENUECAT_ENTITLEMENT_ID    identifiant du droit (défaut : premium)
# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY sont fournis automatiquement aux Edge Functions.
