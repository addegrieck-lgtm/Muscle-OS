// LUMÉANCE sur Cloudflare Workers (adaptateur OpenNext : rendu serveur, actions, middleware, API).
// Workers Builds : dossier racine « lumeance », build « npx opennextjs-cloudflare build »,
// déploiement « npx opennextjs-cloudflare deploy ». Variables : voir docs/HEBERGEMENT.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lumeance",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "lumeance" }],
  // Optimisation des images (next/image) par Cloudflare Images.
  "images": { "binding": "IMAGES" },
  "observability": { "enabled": true }
}
