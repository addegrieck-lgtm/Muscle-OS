{
  "name": "lumeance",
  "version": "0.1.0",
  "private": true,
  "description": "LUMÉANCE — maison française de luminaires design. Showroom, boutique et administration.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:db": "bash supabase/tests/run.sh",
    "check": "npm run typecheck && npm run lint && npm test",
    "admin:init": "node scripts/init-admin.mjs",
    "brand": "node scripts/build-brand.mjs",
    "brand:raster": "node scripts/render-raster.mjs",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "catalog:sql": "node --experimental-strip-types --no-warnings scripts/export-catalog-sql.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.15",
    "@react-three/fiber": "^9.8.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "gsap": "^3.15.0",
    "next": "^15.5.28",
    "react": "19.2",
    "react-dom": "19.2",
    "server-only": "^0.0.1",
    "three": "^0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "opentype.js": "^2.0.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "three-gpu-pathtracer": "^0.0.27",
    "three-mesh-bvh": "^0.9.17",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.156.0",
    "xatlas-web": "^0.1.0"
  }
}
