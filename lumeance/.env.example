# ── Site ───────────────────────────────────────────────
# URL canonique (sans slash final). Domaine souhaité, NON acheté à ce jour.
NEXT_PUBLIC_SITE_URL=http://localhost:3100
# 1 = autoriser l'indexation (production uniquement, une fois le domaine et les mentions légales validés)
NEXT_PUBLIC_INDEXABLE=0

# ── Supabase (facultatif en développement) ─────────────
# Sans ces variables, le site tourne sur le catalogue de DÉMONSTRATION et l'administration
# affiche « service non configuré ».
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé service_role : SERVEUR UNIQUEMENT (jamais préfixée NEXT_PUBLIC_). Utilisée par le script
# d'initialisation du premier administrateur et l'enregistrement des demandes de commande.
SUPABASE_SERVICE_ROLE_KEY=

# ── Paiement (désactivé en V1) ─────────────────────────
# Ne passer à 1 qu'après intégration réelle d'un prestataire (voir docs/PAIEMENT.md).
PAYMENTS_ENABLED=0
PAYMENT_PROVIDER=
