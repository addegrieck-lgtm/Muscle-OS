# ── API VÆLORIA ── copier en .env (jamais commité)
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
# PostgreSQL (dev : base locale ; jamais les données de production)
DATABASE_URL=postgres://vaeloria:vaeloria@localhost:5432/vaeloria
# Base dédiée aux tests automatiques (elle est vidée à chaque exécution)
DATABASE_URL_TEST=postgres://vaeloria:vaeloria@localhost:5432/vaeloria_test

# Origines autorisées (CORS) — séparées par des virgules
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Plugin VæloriaBridge : paires keyId:secret séparées par des virgules.
# Deux clés peuvent coexister pendant une rotation. Secret : 32+ caractères aléatoires.
#   openssl rand -hex 32
BRIDGE_KEYS=factions-1:remplacer-par-un-secret-aleatoire-de-64-caracteres-hex-000000

# Jeton serveur-à-serveur pour l'admin (en attendant les rôles via Discord OAuth)
ADMIN_API_TOKEN=remplacer-par-un-jeton-long-et-aleatoire

# Ping Minecraft (Server List Ping) utilisé tant que le plugin n'envoie pas de heartbeat
MC_PING_HOST=play.vaeloria.fr
MC_PING_PORT=25565

# Webhook Discord pour les annonces (facultatif)
DISCORD_WEBHOOK_URL=

# ── Comptes ──
# Jeton partagé avec le site (routes /internal) — identique à WEB_INTERNAL_TOKEN du site
WEB_INTERNAL_TOKEN=remplacer-par-un-jeton-long-et-aleatoire
# Application Discord (https://discord.com/developers/applications) — redirection : <SITE_URL>/api/auth/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Code secret (16 caractères min.) pour devenir propriétaire depuis « Mon compte → Accès équipe ».
# À définir au premier déploiement, utiliser une fois, puis vider.
ADMIN_SETUP_CODE=
# Connexion sans Discord : développement uniquement (refusée en production)
DEV_LOGIN=0

# ── Boutique ──
SITE_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000
# none | sandbox (test, interdit en production) | stripe
PAYMENT_PROVIDER=none
SANDBOX_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
# Secret de signature du endpoint webhook Stripe : <PUBLIC_API_URL>/webhooks/payments/stripe
STRIPE_WEBHOOK_SECRET=
