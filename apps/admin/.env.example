# URL interne de l'API et jeton admin (côté serveur uniquement, jamais envoyé au navigateur)
API_URL=http://localhost:4000
ADMIN_API_TOKEN=dev-admin-token-0123456789abcdef
# URL du site : le back-office demande une connexion avec un compte du site (rôle admin ou owner)
SITE_URL=http://localhost:3000
# Secours facultatif : Basic Auth (laisser vide pour le désactiver)
ADMIN_USER=
ADMIN_PASSWORD=
