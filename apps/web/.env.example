# URL de l'API, appelée côté serveur uniquement (jamais exposée au navigateur)
API_URL=http://localhost:4000
# URL publique du site (canonical, sitemap, OpenGraph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Jeton partagé avec l'API (routes /internal de connexion)
WEB_INTERNAL_TOKEN=
# Identifiant public de l'application Discord (le secret reste dans l'API). Vide = bouton Discord masqué.
DISCORD_CLIENT_ID=
# Connexion de test sans Discord (développement uniquement)
DEV_LOGIN=0
# Stade du projet (prelaunch | beta | open). Vide = valeur de LAUNCH dans @vaeloria/config.
NEXT_PUBLIC_LAUNCH_STAGE=
# Google Search Console : jeton de la balise de validation (propriété « préfixe d'URL »). Vide = pas de balise.
NEXT_PUBLIC_GSC_VERIFICATION=
# Cloudflare Web Analytics (sans cookie) : jeton du site. Vide = désactivé.
NEXT_PUBLIC_CF_BEACON_TOKEN=
# Export statique : 1 = indexable (site public Cloudflare). L'aperçu GitHub Pages le laisse vide.
NEXT_PUBLIC_INDEXABLE=
