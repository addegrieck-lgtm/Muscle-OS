# URL de l'API, appelée côté serveur uniquement (jamais exposée au navigateur)
API_URL=http://localhost:4000
# URL publique du site (canonical, sitemap, OpenGraph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Jeton partagé avec l'API (routes /internal de connexion)
WEB_INTERNAL_TOKEN=
# Identifiant public de l'application Discord (le secret reste dans l'API). Vide = bouton Discord masqué.
DISCORD_CLIENT_ID=
# Connexion de test sans Discord (développement uniquement)
DEV_LOGIN=0
