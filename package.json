{
  "name": "vaeloria",
  "private": true,
  "version": "0.1.0",
  "description": "VÆLORIA — site officiel, API, administration et intégration Minecraft",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "dev:web": "pnpm --filter @vaeloria/web dev",
    "dev:api": "pnpm --filter @vaeloria/api dev",
    "dev:admin": "pnpm --filter @vaeloria/admin dev",
    "build": "API_URL=http://127.0.0.1:9 NEXT_PUBLIC_INDEXABLE=1 NEXT_PUBLIC_SITE_URL=https://vaeloria-site.paysapro-prospection.workers.dev pnpm --filter @vaeloria/web build:preview",
    "build:all": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:migrate": "pnpm --filter @vaeloria/api db:migrate",
    "db:seed": "pnpm --filter @vaeloria/api db:seed"
  }
}
